{
    // Интерпретатор из окружения проекта: в нём установлен aiohttp.
    // Ctrl+ЛКМ по aiohttp/asyncio открывает их исходники (.venv / стандартная библиотека)
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,

    // Pylance проверяет типы по аннотациям: ошибки видны прямо в редакторе
    "python.analysis.typeCheckingMode": "basic",

    "files.exclude": {
        "**/__pycache__": true
    },
    "search.exclude": {
        ".venv/**": true,
        "data/**": true
    }
}
