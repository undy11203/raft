{
    "version": "0.2.0",
    "configurations": [
        {
            // F5: собирает текущий пресет (Debug/Release) и запускает под gdb
            "name": "Debug raft_node (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [
                { "name": "PATH", "value": "C:/msys64/mingw64/bin;${env:PATH}" }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Pretty-printing для STL",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build"
        }
    ]
}
