{
    // F5 — запуск под отладчиком, Ctrl+F5 — запуск без отладчика.
    // Аргументы узлов — пример: поменяй под формат, который сделаешь в argparse.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Node 1",
            "type": "debugpy",
            "request": "launch",
            "module": "raft",
            "cwd": "${workspaceFolder}",
            "args": [
                "--id",
                "1",
                "--port",
                "8001",
                "--peers",
                "2=127.0.0.1:8002",
                "3=127.0.0.1:8003"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Node 2",
            "type": "debugpy",
            "request": "launch",
            "module": "raft",
            "cwd": "${workspaceFolder}",
            "args": [
                "--id",
                "2",
                "--port",
                "8002",
                "--peers",
                "1=127.0.0.1:8001",
                "3=127.0.0.1:8003"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Node 3",
            "type": "debugpy",
            "request": "launch",
            "module": "raft",
            "cwd": "${workspaceFolder}",
            "args": [
                "--id",
                "3",
                "--port",
                "8003",
                "--peers",
                "1=127.0.0.1:8001",
                "2=127.0.0.1:8002"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Check environment",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/check_env.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            // Три узла сразу, у каждого свой терминал; остановка одного не гасит остальные —
            // так удобно проверять перевыборы после «падения» лидера
            "name": "Cluster (3 nodes)",
            "configurations": [
                "Node 1",
                "Node 2",
                "Node 3"
            ]
        }
    ]
}